<?xml version="1.0" encoding="UTF-8" ?>

<configuration>
    <!-- APPENDER is the destination -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoder is the translater -->
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- pattern to log with template (LAYOUT) -->
            <Pattern>
                %d{HH:mm:ss} %highlight(%-5level) %logger{32} - %msg%n
            </Pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>./src/logging/logs/file.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>
                > %d{HH:mm:ss} %-5level %logger{32} - %msg%n
            </Pattern>
        </encoder>
    </appender>

    <!-- ROOT is a base logger that can extends to children -->
    <root level="warn">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- LOGGER have a reference to appender in logger -->
    <logger name="x" level="trace" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="x" level="trace" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

</configuration>

<!--
    %red()	        red
    %green()	    green
    %yellow()	    yellow
    %blue()	        blue
    %cyan()	        cyan
    %magenta()	    magenta
    %white()	    white
    %gray()	        gray
    %highlight()	color by level
-->